<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ControllerSource>$(CclSource)/catenary_for_CCL.importer/pantograph/pantograph_sim_controller.cs</ControllerSource>
  </PropertyGroup>
  <Target Name="CheckImporter" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(ControllerSource)')" Text="Pass -p:CclSource=ABSOLUTE_PATH to the Knsgf/CCL-OCS v1.0.0 or v1.1.0 checkout." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="Bridge/Bridge.csproj" />
    <Compile Include="Program.cs;GamePorts.cs;$(ControllerSource)" />
  </ItemGroup>
</Project>
